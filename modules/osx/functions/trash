#
# Moves files to the macOS trash.
#

# function trash {

emulate -L zsh
setopt LOCAL_OPTIONS EXTENDED_GLOB

local file
local -a files=()
for file in "$@"; do
  if [[ -e $file || -L $file ]]; then
    # ':a' gets the full path (do not use ':A', which would resolve symlinks)
    files+=("${file:a}")
  else
    print "trash: No such file or directory '$file'." >&2
    return 1
  fi
done

if (( $#files == 0 )); then
  print 'usage: trash <files...>' >&2
  return 64  # Match rm's return code.
fi

# Pass paths as arguments so filenames cannot become AppleScript source.
osascript - "${files[@]}" > /dev/null <<'APPLESCRIPT'
on run arguments
  set trashItems to {}
  repeat with filePath in arguments
    set end of trashItems to POSIX file (contents of filePath)
  end repeat
  tell application "Finder" to move trashItems to trash
end run
APPLESCRIPT

# }
