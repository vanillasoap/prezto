#
# Removes a Git submodule.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

if (( $# != 1 )); then
  print -u2 -- "usage: $0 path"
  return 2
fi

local root source_path="${1%/}" entry
root="$(command git rev-parse --show-toplevel 2> /dev/null)" || return 1
if [[ $PWD:A != $root:A ]]; then
  print -u2 -- "$0: must be run from the root of the work tree"
  return 1
fi

# Check the gitlink itself: submodule names can differ from their paths.
source_path="${source_path#./}"
entry="$(command git --literal-pathspecs ls-files --stage -z -- "$source_path")" || return
entry="${entry%$'\0'}"
if [[ $entry != 160000\ *$'\t'"$source_path" || $entry == *$'\0'* ]]; then
  print -u2 -- "$0: not a submodule path: $1"
  return 1
fi

# Git checks for local changes and retains the repository's object database.
command git --literal-pathspecs rm -- "$source_path"
